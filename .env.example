# Copy to .env. Never commit .env or the .data directory.
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=.data/aurora.sqlite
NODE_ENV=development
# Password recovery writes private local messages under .data/mail-outbox.
# It is automatically disabled in production unless an email delivery adapter is provided.
AUTH_LOCAL_RECOVERY=true

# Initial store settings only. After first startup, change delivery, tax,
# support email and cash on delivery in /admin.html; SQLite keeps those edits.
# USD cents. Standard US shipping is free from $150.
SHIPPING_CENTS=995
FREE_SHIPPING_CENTS=15000
# Configure applicable taxes before accepting live orders.
TAX_RATE_BPS=0
ALLOW_COD=true

# Both keys are required to offer Stripe Checkout. Start with test keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional customer support email displayed in checkout.
SUPPORT_EMAIL=
